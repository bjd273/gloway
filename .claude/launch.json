{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["--directory", "backend", "run", "uvicorn", "api.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
