# Gloway environment — copy to `.env` at the REPO ROOT (not inside backend/).
#
#     cp .env.example .env
#
# Two files read this: `infra/docker-compose.yml` interpolates DB_USER and
# DB_PASSWORD into the Postgres service, and `backend/config.py` loads the whole
# file into its pydantic-settings `Settings` object. Anything not listed here
# falls back to the default declared in `backend/config.py`.
#
# The real `.env` is gitignored. Never commit it.


# --- Database ---------------------------------------------------------------
# DB_USER / DB_PASSWORD are consumed by docker-compose to provision the
# Postgres container. DATABASE_URL is what the backend connects with, so the
# credentials in it must match the two above.
DB_USER=postgres
DB_PASSWORD=adaptivemap
DATABASE_URL=postgresql+asyncpg://postgres:adaptivemap@postgres:5432/adaptivemap


# --- Routing engine ---------------------------------------------------------
# Note the hostname is the compose service name, not localhost. That is correct
# for both cases: `backend/config.py` rewrites `valhalla` -> `localhost` (and
# does the same for qdrant and mlflow) whenever it does not find `/.dockerenv`,
# so one .env works whether the backend runs inside Compose or on your machine.
VALHALLA_URL=http://valhalla:8002

# True  = boot from the cached valhalla_tiles.tar, ignoring any .pbf. Restarts
#         are near-instant. This is what you want day to day.
# False = force the entrypoint to rebuild tiles from the .pbf on next start.
#         `scripts/rebuild_region.sh` flips this for one run and flips it back;
#         you rarely need to set it by hand.
VALHALLA_USE_CACHED_TILES=True


# --- Map data ---------------------------------------------------------------
# Which MapDataSource `backend/mapdata/factory.py` constructs:
#   osm      — Overpass for places, Nominatim for addresses (no local files)
#   overture — local Overture Places parquet, via duckdb
#   hybrid   — OSM for routing + addresses, Overture for places (default)
MAP_DATA_SOURCE=hybrid

# Only read when MAP_DATA_SOURCE is `overture` or `hybrid`. A missing file is
# not fatal: you get a startup warning and place search degrades to
# Nominatim-only. Regenerate with `data/download_overture.sh`.
# Defaults to <repo>/data/overture/places.parquet — uncomment to move it.
# OVERTURE_PLACES_PATH=/absolute/path/to/places.parquet


# --- LLM conversation layer -------------------------------------------------
# Leaving GEMINI_API_KEY empty is a supported configuration, not a broken one:
# every conversation, voice and debrief endpoint returns 503, and the frontend
# hides that UI rather than showing an error. Routing, search, preferences and
# the drive loop all work without it.
#
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=


# --- Phase 3 / ML infrastructure --------------------------------------------
# Both are declared so the services can be reached when you opt into them.
# Nothing in the request path requires either one today.

# Vector store for per-user preference embeddings. Only `ml/rl/preference_
# embedding.py` and its tests touch it, and the tests run fully in-memory.
QDRANT_URL=http://localhost:6333

# Experiment tracking for RL training runs. Empty = a local sqlite store
# (mlruns.db), which is all a smoke run needs. Set to http://mlflow:5000 to log
# to the Compose service instead.
MLFLOW_URL=


# --- Region -----------------------------------------------------------------
# A label recorded on trips so training data can tell which tile build produced
# a route. The routable bounding box itself is NOT set here — it lives in
# `data/region.json`, the single source every derived artifact reads. To change
# coverage, edit that file and run `./scripts/rebuild_region.sh`.
ROUTING_REGION_ID=central-arlington
