# Temporary files
.tmp/
.env
credentials.json
token.json

# OSM data downloads (regenerate via data/download_osm.sh)
data/osm/*.pbf

# Overture places extract (regenerate via data/download_overture.sh)
data/overture/*.parquet*

# Valhalla build output (regenerate via docker compose)
valhalla/custom_files/*
!valhalla/custom_files/.gitkeep

# Planetiler tile build output + auxiliary sources (regenerate via
# `docker run ghcr.io/onthegomap/planetiler --osm-path=... --download`)
data/tiles/
data/sources/
data/tile_weights.tsv.gz

# Python
__pycache__/
*.pyc
.venv/

# RL training artifacts (trained policies + experiment tracking, regenerate via
# backend/scripts/train_rl.py)
backend/models/
backend/mlruns/
backend/mlruns.db
backend/mlartifacts/
tensorboard_logs/

# Local design-review tool state
.impeccable/
